# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# ── Site URL ──────────────────────────────────────────────────────────────────
# The canonical base URL of your site (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://viptaxiserviceksa.com

# ── Google Analytics 4 ───────────────────────────────────────────────────────
# Your GA4 Measurement ID (e.g. G-XXXXXXXXXX)
# Leave empty to disable analytics entirely
NEXT_PUBLIC_GA_ID=

# ── Search Console Verification ──────────────────────────────────────────────
# The value of <meta name="google-site-verification" content="...">
NEXT_PUBLIC_GSC_VERIFICATION=

# ── Bing Webmaster Tools Verification ────────────────────────────────────────
NEXT_PUBLIC_BING_VERIFICATION=

# ── Resend (email notifications for lead form) ────────────────────────────────
# Get your API key from resend.com
RESEND_API_KEY=

# ── Lead notification email ───────────────────────────────────────────────────
# Where to send new lead form submissions
LEAD_NOTIFY_EMAIL=
