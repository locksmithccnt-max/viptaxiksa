# Copy to .env.local and fill in values

# Required — your full domain (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://viptaxiserviceksa.com

# Google Analytics 4 — Measurement ID (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Resend API key — for email lead notifications (optional; WA-only fallback if empty)
RESEND_API_KEY=

# Resend — recipient email for lead notifications
RESEND_TO_EMAIL=

# Cloudflare Turnstile — CAPTCHA for the lead form (optional)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# IndexNow key — for Bing/Yandex ping on deploy
INDEXNOW_KEY=

# Google Search Console verification meta tag value
NEXT_PUBLIC_GSC_VERIFICATION=

# Bing Webmaster Tools verification meta tag value
NEXT_PUBLIC_BING_VERIFICATION=
